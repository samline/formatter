{
  "name": "@samline/formatter",
  "version": "3.2.2",
  "description": "Lightweight, framework-agnostic input formatter (numeral, date, time, credit card, general, opt-in phone) that returns split formatted/raw outputs, plus Intl display helpers and dependency-free date tools.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "import": "./dist/phone/index.js",
      "require": "./dist/phone/index.cjs"
    },
    "./intl": {
      "types": "./dist/intl/index.d.ts",
      "import": "./dist/intl/index.js",
      "require": "./dist/intl/index.cjs"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js",
      "require": "./dist/date/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/formatter.d.ts",
      "default": "./dist/browser/formatter.global.js"
    },
    "./browser/phone": {
      "types": "./dist/browser/formatter.phone.d.ts",
      "default": "./dist/browser/formatter.phone.global.js"
    },
    "./browser/date": {
      "types": "./dist/browser/formatter.date.d.ts",
      "default": "./dist/browser/formatter.date.global.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test && bun run test:package",
    "site:dev": "node site-tools/assets.mjs && node site-tools/dev.mjs",
    "site:build": "node site-tools/assets.mjs && bun run --cwd docs build && bun run --cwd landing build && node site-tools/assemble.mjs && node site-tools/check-site.mjs",
    "site:preview": "bun run --cwd landing preview --host 127.0.0.1 --port 4350 --ignore-lock",
    "site:check": "node site-tools/check-config.mjs && bun run site:check:design && bun run --cwd landing check && bun run --cwd docs check",
    "site:format": "prettier --plugin prettier-plugin-astro --write landing docs/src docs/scripts shared site-tools site-tests site-e2e playwright.site.config.ts project.config.json content-audit.json design-reference.json SITE.md --ignore-path .site-prettierignore",
    "site:format:check": "prettier --plugin prettier-plugin-astro --check landing docs/src docs/scripts shared site-tools site-tests site-e2e playwright.site.config.ts project.config.json content-audit.json design-reference.json SITE.md --ignore-path .site-prettierignore",
    "site:test": "node --test site-tests/*.test.mjs",
    "site:test:browser": "playwright test --config playwright.site.config.ts",
    "site:verify": "bun run site:check && bun run site:format:check && bun run site:test && bun run site:test:adaptation && bun run site:build && bun run site:check:identity && bun run site:test:browser",
    "site:configure": "node site-tools/configure.mjs",
    "site:check:release": "bun run site:check:identity && node site-tools/check-release.mjs",
    "site:test:adaptation": "node site-tools/test-adaptation.mjs",
    "site:check:design": "node site-tools/check-design.mjs",
    "test:package": "vitest run --config vitest.dist.config.ts",
    "site:check:identity": "node site-tools/check-identity.mjs",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "check": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run size && bun run test:package && bun run test:e2e",
    "release": "bun run check && pnpm publish"
  },
  "keywords": [
    "formatter",
    "input",
    "phone",
    "numeral",
    "date",
    "time",
    "credit-card",
    "format",
    "mask",
    "intl",
    "libphonenumber",
    "dates",
    "date-format",
    "date-parse",
    "timezone",
    "duration"
  ],
  "author": "Samuel Olvera (samline)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/formatter.git"
  },
  "bugs": {
    "url": "https://github.com/samline/formatter/issues"
  },
  "homepage": "https://samline.github.io/formatter/",
  "dependencies": {
    "libphonenumber-js": "^1.13.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@samline/string": "^1.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.9.1",
  "unpkg": "./dist/browser/formatter.global.js",
  "jsdelivr": "./dist/browser/formatter.global.js",
  "size": {
    "dist/index.js": 11800,
    "dist/vanilla/index.js": 11800,
    "dist/phone/index.js": 33500,
    "dist/intl/index.js": 1800,
    "dist/date/index.js": 10100,
    "dist/browser/formatter.global.js": 13500,
    "dist/browser/formatter.phone.global.js": 46800,
    "dist/browser/formatter.date.global.js": 9400
  }
}
