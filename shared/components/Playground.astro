---
import type { HTMLAttributes } from 'astro/types'
import { registerPhone } from '@samline/formatter/phone'
import DemoStudio from './DemoStudio.astro'
import DemoPanel from './DemoPanel.astro'
import DemoFooter from './DemoFooter.astro'
import Button from './Button.astro'
import Select from './Select.astro'
import Disclosure from './Disclosure.astro'
import DemoCode from './DemoCode.astro'
import t, { scenarios, type DemoPreset, type Scenario } from '../i18n/translations/en/demo'
import { callSignature } from '../lib/demo-source'
import { evaluate, ruleLabel as labelFor } from '../lib/demo-runtime'
// The phone scenario renders on the server too; phone support is opt-in.
registerPhone()
interface Props extends HTMLAttributes<'div'> {
  showCode?: boolean
  preset?: DemoPreset
  framed?: boolean
}
const {
  id = `demo-${crypto.randomUUID()}`,
  showCode = false,
  preset = 'phone',
  framed = true,
  class: className,
  ...attributes
} = Astro.props
const item: Scenario = scenarios[preset]
const field = item.field
const fieldId = `${id}-${field.id}`
const choice = item.choice
const validation = item.formatType === null
// Render the initial result at build time so the preview is complete without
// JavaScript and does not shift when the script takes over.
const initial = evaluate(item, field.value, choice?.initial)
const brand = initial.brand
const status = initial.status
const validLabel = validation ? t.validLabel : (item.check?.valid ?? '')
const ruleLabel = labelFor(item)
const Frame = framed ? DemoStudio : 'div'
---

<div {...attributes} data-ui class:list={['playground', className]}>
  <package-site-demo data-preset={preset} role="group" aria-labelledby={`${id}-label`}>
    <Frame>
      <DemoPanel label={item.tab} tagline={validation ? t.validationTagline : t.previewTagline}>
        <div class:list={['specimen']}>
          <div class:list={['field-column']}>
            <p id={`${id}-label`} class:list={['sr-only']}>
              {item.title}
            </p>
            <code class:list={['signature']}>{callSignature(preset)}</code>
            {choice && (
              <Select
                id={`${id}-${choice.id}`}
                label={choice.label}
                options={choice.choices}
                value={choice.initial}
                data-choice={choice.role}
              />
            )}
            <div class:list={['control']}>
              <label for={fieldId}>{field.label}</label>
              <input
                id={fieldId}
                type="text"
                inputmode={field.inputmode}
                autocomplete={field.autocomplete}
                placeholder={field.placeholder}
                value={initial.formatted}
                spellcheck="false"
                aria-describedby={
                  validation ? `${id}-status` : `${id}-raw${status ? ` ${id}-status` : ''}`
                }
                data-field
              />
            </div>
            <p class:list={['preview-description']}>{item.description}</p>
          </div>
          <dl class:list={['readout']}>
            {validation ? (
              <div>
                <dt>{t.patternLabel}</dt>
                <dd>
                  <output data-pattern>{initial.pattern}</output>
                </dd>
              </div>
            ) : (
              <>
                <div>
                  <dt>{t.formattedLabel}</dt>
                  <dd>
                    <output data-formatted>{initial.formatted || t.emptyRaw}</output>
                  </dd>
                </div>
                <div class:list={['raw']}>
                  <dt id={`${id}-raw`}>{t.rawLabel}</dt>
                  <dd>
                    <output data-raw>{initial.raw || t.emptyRaw}</output>
                  </dd>
                </div>
              </>
            )}
            {brand !== null && item.brand && (
              <div>
                <dt>{item.brand.label}</dt>
                <dd>
                  <output data-brand>{brand}</output>
                </dd>
              </div>
            )}
            {item.dateReadout?.outputs.map((output, index) => (
              <div>
                <dt>{output.label}</dt>
                <dd>
                  <output data-date={index}>{initial.dates![index]}</output>
                </dd>
              </div>
            ))}
            {status && (
              <div>
                <dt>{ruleLabel}</dt>
                <dd>
                  <span
                    id={`${id}-status`}
                    class:list={['status']}
                    data-status
                    data-valid={String(status.valid)}
                    data-valid-label={validLabel}
                    aria-live="polite"
                  >
                    {status.text}
                  </span>
                </dd>
              </div>
            )}
          </dl>
        </div>
      </DemoPanel>
      <DemoFooter note={item.hint}>
        <div class:list={['samples']}>
          <span class:list={['samples-label']}>{t.samplesLabel}</span>
          {item.samples.map(sample => (
            <Button
              variant="secondary"
              data-sample={sample.value}
              data-sample-choice={sample.choice}
              disabled
            >
              {sample.label}
            </Button>
          ))}
          <Button variant="secondary" data-reset={field.value} disabled>
            {t.reset}
          </Button>
        </div>
      </DemoFooter>
      <noscript>
        <p class:list={['noscript']}>{t.noscript}</p>
      </noscript>
    </Frame>
  </package-site-demo>
  {showCode && (
    <Disclosure class:list={['code-disclosure']}>
      <span slot="summary">{t.openCode}</span>
      <div class:list={['code-body']}>
        <DemoCode preset={preset} />
      </div>
    </Disclosure>
  )}
</div>

<script>
  import { registerPhone } from '@samline/formatter/phone'
  import { mountElements } from '../lib/mount-elements'
  import { evaluate } from '../lib/demo-runtime'
  import { scenarios, type DemoPreset, type Scenario } from '../i18n/translations/en/demo'
  import t from '../i18n/translations/en/demo'

  registerPhone()

  mountElements('package-site-demo', element => {
    const item: Scenario | undefined = scenarios[element.dataset.preset as DemoPreset]
    const field = element.querySelector<HTMLInputElement>('[data-field]')
    if (!item || !field) return
    const lifecycle = new AbortController()
    const { signal } = lifecycle
    const select = element.querySelector<HTMLSelectElement>('select[data-choice]')
    const formattedOutput = element.querySelector('output[data-formatted]')
    const rawOutput = element.querySelector('output[data-raw]')
    const patternOutput = element.querySelector('output[data-pattern]')
    const brand = element.querySelector('output[data-brand]')
    const dates = element.querySelectorAll('output[data-date]')
    const status = element.querySelector<HTMLElement>('[data-status]')

    const update = () => {
      const state = evaluate(item, field.value, select?.value)
      if (item.formatType) field.value = state.formatted
      if (formattedOutput) formattedOutput.textContent = state.formatted || t.emptyRaw
      if (rawOutput) rawOutput.textContent = state.raw || t.emptyRaw
      if (patternOutput && state.pattern !== null) patternOutput.textContent = state.pattern
      if (brand && state.brand !== null) brand.textContent = state.brand
      dates.forEach((output, index) => (output.textContent = state.dates?.[index] ?? ''))
      if (status && state.status) {
        status.dataset.valid = String(state.status.valid)
        status.textContent = state.status.text
      }
    }

    field.addEventListener('input', update, { signal })
    select?.addEventListener('change', update, { signal })
    for (const button of element.querySelectorAll<HTMLButtonElement>(
      '[data-sample], [data-reset]'
    )) {
      button.disabled = false
      button.addEventListener(
        'click',
        () => {
          const reset = button.hasAttribute('data-reset')
          field.value = button.dataset.sample ?? button.dataset.reset ?? ''
          const choice = reset ? item.choice?.initial : button.dataset.sampleChoice
          if (select && choice) select.value = choice
          update()
        },
        { signal }
      )
    }
    update()
    return () => lifecycle.abort()
  })
</script>

<style>
  .playground {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    min-width: 0;
  }
  package-site-demo {
    display: block;
    min-width: 0;
  }
  .specimen {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.75rem;
    align-items: start;
    min-height: 15rem;
  }
  .field-column {
    display: grid;
    gap: 0.875rem;
    min-width: 0;
  }
  .signature {
    justify-self: start;
    max-width: 100%;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--theme-accent-soft);
    color: var(--color-text);
    font: 0.75rem/1.5 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .control {
    display: grid;
    gap: 0.375rem;
  }
  .control label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .control input {
    box-sizing: border-box;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-bg-soft);
    color: var(--color-text);
    font: 1.125rem/1.4 var(--font-mono);
    font-variant-numeric: tabular-nums;
    cursor: text;
    transition: border-color 0.15s ease;
  }
  .control input:hover {
    border-color: var(--palette-border-hover, var(--color-accent));
  }
  .control input::placeholder {
    color: var(--color-text-subtle);
  }
  .control input:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  .preview-description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  .readout {
    display: grid;
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-bg);
    overflow: hidden;
  }
  .readout > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    min-width: 0;
  }
  .readout > div + div {
    border-top: 0.0625rem solid var(--color-border);
  }
  .readout .raw {
    background: var(--theme-accent-soft);
  }
  .readout dt {
    font: 0.62rem/1.6 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }
  .readout dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  .status {
    font-family: var(--font-sans, inherit);
    font-size: 0.875rem;
  }
  .status[data-valid='true'] {
    color: var(--color-text);
  }
  .status[data-valid='true']::before {
    content: '✓ ';
    color: var(--color-accent);
  }
  .status[data-valid='false'] {
    color: var(--color-text-muted);
  }
  .samples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }
  .samples-label {
    font: 0.62rem/1.6 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-right: 0.25rem;
  }
  .noscript {
    padding: 1rem 1.5rem;
    margin: 0;
    font-size: var(--text-small);
  }
  .code-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    padding: var(--space-sm);
  }
  .code-disclosure {
    margin-top: var(--space-lg);
    padding-block: var(--space-xs);
  }
  @media (width < 48rem) {
    .specimen {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .control input {
      transition: none;
    }
  }
</style>
