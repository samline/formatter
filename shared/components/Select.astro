---
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'select'> {
  label: string
  id: string
  options: readonly (readonly [value: string, label: string])[]
  value?: string
}
const { label, id, options, value, class: className, ...attributes } = Astro.props
---

<div data-ui class:list={['select-field', className]}>
  <label for={id}>{label}</label>
  <span class:list={['control']}>
    <select {...attributes} id={id}>
      {options.map(([optionValue, optionLabel]) => (
        <option value={optionValue} selected={optionValue === value}>
          {optionLabel}
        </option>
      ))}
    </select>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </span>
</div>

<style>
  .select-field {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .control {
    position: relative;
    display: block;
    min-width: 0;
  }
  select {
    appearance: none;
    box-sizing: border-box;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 2.75rem 0.75rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-bg-soft);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  select:hover {
    border-color: var(--palette-border-hover, var(--color-accent));
  }
  select:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  select:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
  svg {
    position: absolute;
    top: 50%;
    right: 0.875rem;
    width: 1.125rem;
    height: 1.125rem;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    select {
      transition: none;
    }
  }
</style>
