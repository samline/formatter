---
import CardGrid from '../../../shared/components/CardGrid.astro'
import { getI18n } from '../i18n/utils'
import Section from '../../../shared/components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import RichText from '../components/RichText.astro'
import FeatureCard from '../components/FeatureCard.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.features
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section
  aria-labelledby={headingId}
  spacing="none"
  id="features"
  class:list={['content-section features-section']}
>
  <Box>
    <SectionHeading
      headingId={headingId}
      context="features"
      eyebrow={t.eyebrow}
      class:list={['mb-12 flex flex-col items-start gap-3']}
    >
      {t.title}
      <br />
      <span class:list={['serif italic']}>{t.titleAccent}</span>
    </SectionHeading>

    <CardGrid columns={3} class:list={['feature-grid']}>
      <FeatureCard title={t.items.dependencies.title} number="01">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.dependencies.description} />
      </FeatureCard>
      <FeatureCard title={t.items.accessibility.title} number="02">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </Fragment>
        <RichText parts={t.items.accessibility.description} />
      </FeatureCard>
      <FeatureCard title={t.items.lifecycle.title} number="03">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
            <path d="M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
            <path d="M3 21v-5h5"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.lifecycle.description} />
      </FeatureCard>
      <FeatureCard title={t.items.entrypoints.title} number="04">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="5" cy="5" r="3"></circle>
            <circle cx="19" cy="5" r="3"></circle>
            <circle cx="12" cy="19" r="3"></circle>
            <path d="M5 8v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8M12 12v4"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.entrypoints.description} />
      </FeatureCard>
      <FeatureCard title={t.items.frameworks.title} number="05">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.frameworks.description} />
      </FeatureCard>
      <FeatureCard title={t.items.markup.title} number="06">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.markup.description} />
      </FeatureCard>
    </CardGrid>
  </Box>
</Section>

<style>
  .feature-grid {
    gap: 0.75rem;
  }
  @media (width < 48rem) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < 30rem) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
