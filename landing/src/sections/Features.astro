---
import CardGrid from '../../../shared/components/CardGrid.astro'
import { getI18n } from '../i18n/utils'
import Section from '../../../shared/components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import RichText from '../components/RichText.astro'
import FeatureCard from '../components/FeatureCard.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.features
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section
  aria-labelledby={headingId}
  spacing="none"
  id="features"
  class:list={['content-section features-section']}
>
  <Box>
    <SectionHeading
      headingId={headingId}
      context="features"
      eyebrow={t.eyebrow}
      class:list={['mb-12 flex flex-col items-start gap-3']}
    >
      {t.title}
      <br />
      <span class:list={['serif italic']}>{t.titleAccent}</span>
    </SectionHeading>

    <CardGrid columns={3} class:list={['feature-grid']}>
      <FeatureCard title={t.items.dependencies.title} number="01">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 3h5v5"></path>
            <path d="M8 3H3v5"></path>
            <path d="M12 22v-8.3a4 4 0 0 0-1.17-2.87L3 3"></path>
            <path d="m15 9 6-6"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.dependencies.description} />
      </FeatureCard>
      <FeatureCard title={t.items.accessibility.title} number="02">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h-1a2 2 0 0 1-2-2 2 2 0 0 1-2 2H6"></path>
            <path d="M13 8h7a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-7"></path>
            <path d="M5 16H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h1"></path>
            <path d="M6 4h1a2 2 0 0 1 2 2 2 2 0 0 1 2-2h1"></path>
            <path d="M9 6v12"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.accessibility.description} />
      </FeatureCard>
      <FeatureCard title={t.items.lifecycle.title} number="03">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M9 17c2 0 2.8-1 2.8-2.8V10c0-2 1-3.3 3.2-3"></path>
            <path d="M9 11.2h5.7"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.lifecycle.description} />
      </FeatureCard>
      <FeatureCard title={t.items.entrypoints.title} number="04">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
            <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
            <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.entrypoints.description} />
      </FeatureCard>
      <FeatureCard title={t.items.frameworks.title} number="05">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5.5 8.5 9 12l-3.5 3.5L2 12l3.5-3.5Z"></path>
            <path d="m12 2 3.5 3.5L12 9 8.5 5.5 12 2Z"></path>
            <path d="M18.5 8.5 22 12l-3.5 3.5L15 12l3.5-3.5Z"></path>
            <path d="m12 15 3.5 3.5L12 22l-3.5-3.5L12 15Z"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.frameworks.description} />
      </FeatureCard>
      <FeatureCard title={t.items.markup.title} number="06">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.markup.description} />
      </FeatureCard>
    </CardGrid>
  </Box>
</Section>

<style>
  .feature-grid {
    gap: 0.75rem;
  }
  @media (width < 48rem) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < 30rem) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
